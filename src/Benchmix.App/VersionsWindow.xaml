<Window x:Class="Benchmix.App.VersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Versions" Width="440" Height="400" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg1Brush}" Foreground="{StaticResource Text0Brush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Intro" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{StaticResource Text1Brush}"/>
        <ListBox x:Name="List" Grid.Row="1" DisplayMemberPath="Label" FontSize="13"
                 Background="{StaticResource Bg0Brush}" Foreground="{StaticResource Text0Brush}"
                 BorderBrush="{StaticResource LineBrush}" MouseDoubleClick="OnDoubleClick"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Restore" Style="{StaticResource PrimaryButton}" Click="OnRestore" IsDefault="True" MinWidth="90"/>
            <Button Content="Cancel" Style="{StaticResource ToolButton}" Click="OnCancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
