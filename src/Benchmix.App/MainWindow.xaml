<Window x:Class="Benchmix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Benchmix.App.Controls"
        xmlns:vm="clr-namespace:Benchmix.App.ViewModels"
        Title="{Binding WindowTitle}" Height="820" Width="1400"
        MinHeight="560" MinWidth="1000"
        Background="{StaticResource Bg0Brush}"
        AllowDrop="True" Drop="OnFilesDropped" DragOver="OnDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding RenderCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomFitCommand}"/>

        <!-- Sections. Every one is Ctrl-modified on purpose: a bare-key binding on the Window
             fires from inside the PROJECT BPM box too, because a TextBox does not mark a plain
             character's KeyDown as handled. Binding Delete or S here would make editing that box
             destructive. Delete is the one bare key that acts, and for that reason it is handled
             in code (OnWindowPreviewKeyDown) only when the focus is not in a text box. -->
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding SplitAtPlayheadCommand}"/>
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutClipCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyClipCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteClipCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateClipCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding AddEmptyTrackCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ToggleLoopModeCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ToggleRampModeCommand}"/>
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleMarkModeCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding ToggleWarpModeCommand}"/>
        <KeyBinding Key="J" Modifiers="Ctrl" Command="{Binding JoinSectionsCommand}"/>
        <!-- Tabs (2026-10-27): the next tab along, and the one before. -->
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding PreviousTabCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ toolbar ============ -->
        <Border Grid.Row="0" Background="{StaticResource Bg1Brush}" Padding="10,7"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="BENCHMIX" FontWeight="Bold" FontSize="13" Margin="2,0,16,0"
                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                <Button Content="New" Style="{StaticResource ToolButton}" Command="{Binding NewCommand}"
                        ToolTip="Start a new, empty project. Asks first if there are unsaved changes (Ctrl+N)."/>
                <Button Content="Open" Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}"
                        ToolTip="Open a saved .benchmix project (Ctrl+O)."/>
                <Button Content="Save" Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}"
                        ToolTip="Save the project: your work in progress, not the audio (Ctrl+S; Ctrl+Shift+S saves a copy)."/>
                <Separator Width="10" Background="Transparent"/>
                <Button Content="+ Add tracks" Style="{StaticResource PrimaryButton}" Command="{Binding AddTracksCommand}"
                        ToolTip="Add songs, one track each, starting at 0:00. Dropping files onto the window adds them where you drop them."/>
                <Button Content="+ Empty track" Style="{StaticResource ToolButton}" Command="{Binding AddEmptyTrackCommand}"
                        ToolTip="Add a track with nothing on it, to paste or drag sections onto (Ctrl+T)."/>
                <Button Content="Render to file" Style="{StaticResource ToolButton}" Command="{Binding RenderCommand}"
                        ToolTip="Write the whole mix, start to end, to a WAV file (Ctrl+E)."/>
                <ToggleButton Content="LOOP MODE" Style="{StaticResource PillToggle}" Margin="10,0,0,0" Padding="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding LoopMode, Mode=TwoWay}"
                              ToolTip="While on, dragging either end of a section repeats it instead of trimming it (Ctrl+L). It moves in whole repeats; hold Ctrl for part of one. This builds repeats on the track — it is not the Shift-drag listening loop."/>
                <ToggleButton Content="RAMP MODE" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Padding="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding RampMode, Mode=TwoWay}"
                              ToolTip="While on, click a track twice to change its tempo gradually between the two points (Ctrl+R): the first click starts at the tempo it is playing, at the second you type the tempo to reach. Drag a dot to move it, click the end dot to change its tempo, right-click the line to remove it. Sections stay put while it is on."/>
                <ToggleButton Content="MARK MODE" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Padding="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding MarkMode, Mode=TwoWay}"
                              ToolTip="While on, drag across a track to mark a stretch of it (Ctrl+M). Ctrl+C copies the marked stretch, Ctrl+X cuts it, Delete removes it and Ctrl+D repeats it; drag either end of the mark to move it. A click puts the playhead there, so Ctrl+V pastes there; Shift+click marks from the playhead. Sections stay put while it is on."/>
                <ToggleButton Content="WARP MODE" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Padding="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding WarpMode, Mode=TwoWay}"
                              ToolTip="While on, click a track on a beat that is still in time to pin it with a warp marker, then drag a beat that has drifted onto where it should be (Ctrl+W). The audio between two markers is evened out to fit; nothing before the one on the left moves, and everything after the last moves with it. A dragged beat snaps to edges on other tracks; hold Ctrl to drag it freely. Right-click a marker to remove it. Sections stay put while it is on."/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Fit" Style="{StaticResource ToolButton}" Command="{Binding ZoomFitCommand}"
                            ToolTip="Zoom so the whole mix fits the window (Ctrl+0)."/>
                    <Button Content="&#x2212;" Style="{StaticResource ToolButton}" Command="{Binding ZoomOutCommand}"
                            ToolTip="Zoom out (Ctrl and the minus key)."/>
                    <Button Content="+" Style="{StaticResource ToolButton}" Command="{Binding ZoomInCommand}"
                            ToolTip="Zoom in (Ctrl and the = key). Ctrl+scroll zooms about the pointer."/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- ============ transport ============ -->
        <Border Grid.Row="1" Background="{StaticResource Bg1Brush}" Padding="10,8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button Style="{StaticResource TransportButton}" Command="{Binding PlayPauseCommand}"
                        Content="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}" ToolTip="Play / pause (Space)"/>
                <Button Style="{StaticResource TransportButton}" Command="{Binding StopCommand}"
                        Content="&#x25A0;" ToolTip="Stop, and go back to the start. (Clicking the scroll wheel stops and goes back to where you started playing.)"/>

                <TextBlock Margin="16,0,4,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="19"
                           Foreground="{StaticResource Text0Brush}"
                           Text="{Binding PositionSeconds, Converter={StaticResource Time}}"/>
                <TextBlock Margin="0,0,20,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           Text="{Binding TotalSeconds, Converter={StaticResource TimeSlash}}"/>

                <TextBlock Text="PROJECT BPM" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="BpmBox" Style="{StaticResource DarkBox}" Width="62" VerticalAlignment="Center"
                         Text="{Binding ProjectBpm, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                         ToolTip="The tempo the whole mix runs at. Match BPM stretches tracks to it. Type a number, then click away."/>

                <Button Content="Clear loop" Style="{StaticResource ToolButton}" Margin="16,0,0,0"
                        Command="{Binding ClearLoopCommand}" ToolTip="Clear the listening loop. Shift-drag on the ruler sets one; it only changes what plays."/>

                <!-- master on the right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MASTER" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <c:LevelMeter Width="10" Height="30" IsVertical="True" Margin="0,0,2,0"
                                  Value="{Binding MasterLevelLeft}"
                                  MeterBrush="{StaticResource GoodBrush}" WarnBrush="{StaticResource WarnBrush}"
                                  ClipBrush="{StaticResource BadBrush}" TrackBrush="{StaticResource Bg3Brush}"/>
                    <c:LevelMeter Width="10" Height="30" IsVertical="True" Margin="0,0,8,0"
                                  Value="{Binding MasterLevelRight}"
                                  MeterBrush="{StaticResource GoodBrush}" WarnBrush="{StaticResource WarnBrush}"
                                  ClipBrush="{StaticResource BadBrush}" TrackBrush="{StaticResource Bg3Brush}"/>
                    <Slider Width="110" Minimum="0" Maximum="2" Value="{Binding MasterGain}"
                            VerticalAlignment="Center" ToolTip="Overall output level. A limiter after it keeps the mix from clipping."/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- ============ tabs (2026-10-27): separate arrangements in one file ============ -->
        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10,0,10,0"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="TabRow" ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabChip" Margin="0,4,4,0" Padding="10,4" CornerRadius="4,4,0,0" Cursor="Hand"
                                    ToolTip="{Binding Tip}" MouseLeftButtonDown="OnTabMouseDown">
                                <!-- Click handlers only: a ContextMenu lives in its own popup and cannot
                                     reach the window through a binding (MenuWiringTests). -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename tab" Click="OnRenameTabMenu"/>
                                        <MenuItem Header="Move tab left" Click="OnMoveTabLeftMenu"/>
                                        <MenuItem Header="Move tab right" Click="OnMoveTabRightMenu"/>
                                        <Separator/>
                                        <MenuItem Header="Remove tab" Click="OnRemoveTabMenu"
                                                  ToolTip="Takes the tab away with its tracks. Ctrl+Z on the tab you land on brings it back."/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBlock x:Name="TabName" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               Visibility="{Binding IsRenaming, Converter={StaticResource NotBoolVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Text0Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TabRenameBox" Style="{StaticResource DarkBox}" Padding="3,0" Height="19" MinWidth="80"
                                             FontSize="12" MaxLength="80"
                                             Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}"
                                             PreviewKeyDown="OnTabRenameKeyDown" LostKeyboardFocus="OnTabRenameLostFocus"
                                             IsVisibleChanged="OnRenameBoxShown"
                                             ToolTip="Type the tab's new name. Enter keeps it; Esc puts the old one back."/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddTabButton" Content="+" Style="{StaticResource ToolButton}" Margin="2,4,0,0" Padding="9,1" FontSize="12"
                        Command="{Binding AddTabCommand}"
                        ToolTip="A new tab: another arrangement in this file, with tracks of its own. Only the open tab plays and renders."/>
            </StackPanel>
        </Border>

        <!-- ============ ruler + tracks ============ -->
        <Grid Grid.Row="3" x:Name="TimelineGrid"
              PreviewMouseRightButtonDown="OnTimelineRightButtonDown"
              PreviewMouseMove="OnTimelinePreviewMouseMove"
              PreviewMouseRightButtonUp="OnTimelineRightButtonUp"
              ContextMenuOpening="OnTimelineContextMenuOpening">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Bg1Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,1">
                <TextBlock Text="TRACKS" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0"/>
            </Border>

            <Border x:Name="RulerHost" Grid.Row="0" Grid.Column="1" Background="{StaticResource Bg1Brush}"
                    SizeChanged="OnLaneSizeChanged"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnRulerMouseDown" MouseMove="OnRulerMouseMove"
                    MouseLeftButtonUp="OnRulerMouseUp" PreviewMouseWheel="OnRulerWheel" Cursor="Hand">
                <c:TimelineRuler x:Name="Ruler"
                                 PixelsPerSecond="{Binding PixelsPerSecond}"
                                 ScrollSeconds="{Binding ScrollSeconds}"
                                 Bpm="{Binding ProjectBpm}"
                                 Foreground="{StaticResource Text2Brush}"
                                 BarBrush="{StaticResource Bg3Brush}"/>
            </Border>

            <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          x:Name="TrackScroller"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnTimelineWheel">
                <!-- The tracks, then whatever room is left under them. A double-click there plays
                     from that point, as it does on a lane or the ruler; MinHeight makes the room
                     exist whenever the tracks do not fill the view. -->
                <Grid x:Name="TrackContent" MinHeight="{Binding ViewportHeight, ElementName=TrackScroller}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="392"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="TrackList" Grid.ColumnSpan="2" ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrackViewModel}">
                                <Grid Height="152" Background="{StaticResource Bg0Brush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="392"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ────────── channel strip ────────── -->
                                    <!-- Preview, so a press on a knob or a button selects the track too:
                                         those controls handle the press themselves, and the selected
                                         track is where Ctrl+V pastes. -->
                                    <Border x:Name="Strip" Grid.Column="0"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,1"
                                            PreviewMouseLeftButtonDown="OnTrackHeaderClicked"
                                            PreviewMouseRightButtonDown="OnTrackHeaderRightClicked">
                                        <!-- Click handlers only: a ContextMenu lives in its own popup and cannot
                                             reach the window through a binding (MenuWiringTests). -->
                                        <Border.ContextMenu>
                                            <ContextMenu Opened="OnStripMenuOpened">
                                                <MenuItem Header="Rename track" Click="OnRenameTrackMenu"/>
                                                <MenuItem Header="Duplicate track" Click="OnDuplicateTrackMenu"
                                                          ToolTip="A copy right below it: the same sections, knobs, tempo ramps and warp markers."/>
                                                <!-- Its items, one per other tab, are built as the menu opens (OnStripMenuOpened). -->
                                                <MenuItem Header="Move to tab"
                                                          ToolTip="Sends this track to another tab, where it plays instead of here. Ctrl+Z here brings it back."/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="10,7,10,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- name row -->
                                            <DockPanel Grid.Row="0">
                                                <Button DockPanel.Dock="Right" Content="&#x2715;" Style="{StaticResource ToolButton}"
                                                        Padding="6,1" Margin="4,0,0,0" FontSize="10"
                                                        ToolTip="Remove this track from the project. Ctrl+Z brings it back."
                                                        Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <c:LevelMeter DockPanel.Dock="Right" Width="6" Height="15" IsVertical="True"
                                                              Margin="4,0,0,0" Value="{Binding MeterLevel}"
                                                              MeterBrush="{StaticResource GoodBrush}" WarnBrush="{StaticResource WarnBrush}"
                                                              ClipBrush="{StaticResource BadBrush}" TrackBrush="{StaticResource Bg3Brush}"/>
                                                <!-- The grip, the colour and the name. Dragged up or down it moves the
                                                     track; the name double-clicked is renamed, in a box that edits a
                                                     draft, never Name itself, so a refresh of the row cannot wipe it. -->
                                                <Grid x:Name="NameArea" Background="Transparent"
                                                      MouseLeftButtonDown="OnNameMouseDown" MouseMove="OnNameMouseMove"
                                                      MouseLeftButtonUp="OnNameMouseUp" LostMouseCapture="OnNameLostCapture">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="Grip" Text="&#x2261;" FontSize="13" Margin="0,-1,5,0"
                                                               Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Cursor="SizeNS"
                                                               ToolTip="Drag up or down to move this track. Double-click the name to rename it."/>
                                                    <Border Grid.Column="1" Width="4" Height="15" CornerRadius="2"
                                                            Background="{Binding ColorBrush}" Margin="0,0,7,0"/>
                                                    <TextBlock x:Name="NameText" Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource Text0Brush}"
                                                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip="{Binding NameTip}"
                                                               Visibility="{Binding IsRenaming, Converter={StaticResource NotBoolVis}}"/>
                                                    <TextBox x:Name="RenameBox" Grid.Column="2" Style="{StaticResource DarkBox}" Padding="3,0" Height="19"
                                                             FontSize="12.5" VerticalAlignment="Center" MaxLength="80"
                                                             Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}"
                                                             PreviewKeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus"
                                                             IsVisibleChanged="OnRenameBoxShown"
                                                             ToolTip="Type the track's new name. Enter keeps it; Esc puts the old one back."/>
                                                </Grid>
                                            </DockPanel>

                                            <!-- analysis row -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,4">
                                                <TextBlock Text="{Binding BpmText}" Style="{StaticResource Body}"/>
                                                <TextBlock Text="?" Style="{StaticResource Caption}" Margin="3,0,0,0"
                                                           Foreground="{StaticResource WarnBrush}"
                                                           ToolTip="Tempo was estimated from the audio, not read from a tag."
                                                           Visibility="{Binding BpmIsEstimate, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="  &#183;  " Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding KeyText}" Style="{StaticResource Body}"/>
                                                <TextBlock Text="?" Style="{StaticResource Caption}" Margin="3,0,0,0"
                                                           Foreground="{StaticResource WarnBrush}"
                                                           ToolTip="Key was estimated from the audio. Benchmix gets this right about half the time, so trust your ears."
                                                           Visibility="{Binding KeyIsEstimate, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>

                                            <!-- knob row -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <c:Knob Width="58" Height="74" Margin="0,0,4,0"
                                                        Label="TEMPO" Minimum="0.5" Maximum="1.5" DefaultValue="1"
                                                        Value="{Binding Speed, Mode=TwoWay}" ValueText="{Binding SpeedText}"
                                                        EditUnit="Percent" IsBipolar="True"
                                                        ArcBrush="{StaticResource AccentBrush}" TrackBrush="{StaticResource Bg3Brush}"
                                                        KnobBrush="{StaticResource Bg2Brush}" TextBrush="{StaticResource Text1Brush}"
                                                        ToolTip="Speed without changing pitch. On a track with a tempo ramp this is the tempo before the first ramp. Drag up/down, Shift for fine; double-click the knob to reset, or the number to type it (-4.21 is 4.21% slower)."/>
                                                <c:Knob Width="58" Height="74" Margin="0,0,10,0"
                                                        Label="PITCH" Minimum="-12" Maximum="12" DefaultValue="0"
                                                        Value="{Binding Semitones, Mode=TwoWay}" ValueText="{Binding SemitonesText}"
                                                        EditUnit="Semitones" IsBipolar="True"
                                                        ArcBrush="{StaticResource GoodBrush}" TrackBrush="{StaticResource Bg3Brush}"
                                                        KnobBrush="{StaticResource Bg2Brush}" TextBrush="{StaticResource Text1Brush}"
                                                        ToolTip="Pitch in semitones, without changing speed. Drag up/down, Shift for fine; double-click the knob to reset, or the number to type it (to 0.01 of a semitone)."/>

                                                <c:Knob Width="52" Height="74" Label="LOW" Minimum="0" Maximum="2" DefaultValue="1"
                                                        Value="{Binding EqLow, Mode=TwoWay}" ValueText="{Binding EqLowText}" EditUnit="Decibels"
                                                        ArcBrush="{StaticResource WarnBrush}" TrackBrush="{StaticResource Bg3Brush}"
                                                        KnobBrush="{StaticResource Bg2Brush}" TextBrush="{StaticResource Text1Brush}"
                                                        ToolTip="Bass, below about 250 Hz. All the way down is a true kill: the usual move on the vocal track. Double-click the number to type it in dB, or KILL."/>
                                                <c:Knob Width="52" Height="74" Label="MID" Minimum="0" Maximum="2" DefaultValue="1"
                                                        Value="{Binding EqMid, Mode=TwoWay}" ValueText="{Binding EqMidText}" EditUnit="Decibels"
                                                        ArcBrush="{StaticResource WarnBrush}" TrackBrush="{StaticResource Bg3Brush}"
                                                        KnobBrush="{StaticResource Bg2Brush}" TextBrush="{StaticResource Text1Brush}"
                                                        ToolTip="Middle, about 250 Hz to 2.5 kHz: where vocals and guitars live. All the way down is a true kill. Double-click the number to type it in dB, or KILL."/>
                                                <c:Knob Width="52" Height="74" Margin="0,0,10,0" Label="HIGH" Minimum="0" Maximum="2" DefaultValue="1"
                                                        Value="{Binding EqHigh, Mode=TwoWay}" ValueText="{Binding EqHighText}" EditUnit="Decibels"
                                                        ArcBrush="{StaticResource WarnBrush}" TrackBrush="{StaticResource Bg3Brush}"
                                                        KnobBrush="{StaticResource Bg2Brush}" TextBrush="{StaticResource Text1Brush}"
                                                        ToolTip="Treble, above about 2.5 kHz: cymbals and air. All the way down is a true kill. Double-click the number to type it in dB, or KILL."/>

                                                <c:Knob Width="52" Height="74" Label="VOL" Minimum="0" Maximum="2" DefaultValue="1"
                                                        Value="{Binding Gain, Mode=TwoWay}" ValueText="{Binding GainText}" EditUnit="Decibels"
                                                        ArcBrush="{StaticResource Text1Brush}" TrackBrush="{StaticResource Bg3Brush}"
                                                        KnobBrush="{StaticResource Bg2Brush}" TextBrush="{StaticResource Text1Brush}"
                                                        ToolTip="This track's volume. Most of the useful cut is in the last bit of travel before silence. Double-click the number to type it in dB."/>
                                            </StackPanel>

                                            <!-- button row -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                                <Button Content="Match BPM" Style="{StaticResource ToolButton}" FontSize="10.5" Padding="8,3"
                                                        Command="{Binding DataContext.MatchTempoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Stretch this track to the project tempo, pitch untouched. A half- or double-time reading is folded first."/>
                                                <Button Content="Match key" Style="{StaticResource ToolButton}" FontSize="10.5" Padding="8,3"
                                                        Command="{Binding DataContext.MatchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Shift this track's pitch to sit with the key of the track at the top (for the top track, the one below it). Turns LINK off. Applies at once; Ctrl+Z undoes it."/>
                                                <Button Content="Reset" Style="{StaticResource ToolButton}" FontSize="10.5" Padding="8,3"
                                                        ToolTip="Put tempo, pitch, EQ and volume back to normal, and remove tempo ramps and warp markers. Sections, fades, LINK, mute and solo stay as they are."
                                                        Command="{Binding DataContext.ResetTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <ToggleButton Content="LINK" Style="{StaticResource PillToggle}" Margin="4,0,0,0"
                                                              IsChecked="{Binding LinkPitchToTempo, Mode=TwoWay}"
                                                              ToolTip="Let pitch follow tempo, like speeding up a record. Nothing is reconstructed, so nothing can smear; the PITCH knob then just reads along."/>
                                                <ToggleButton Content="M" Style="{StaticResource PillToggle}" Margin="4,0,0,0"
                                                              IsChecked="{Binding Muted, Mode=TwoWay}" ToolTip="Mute this track."/>
                                                <ToggleButton Content="S" Style="{StaticResource PillToggle}" Margin="3,0,0,0"
                                                              IsChecked="{Binding Soloed, Mode=OneWay}" Click="OnSoloClick"
                                                              ToolTip="Solo: hear only this track. Ctrl+click to hear it alongside the tracks already soloed. A muted track stays silent even when soloed."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- the selected track: where Ctrl+V pastes -->
                                    <Border Grid.Column="0" Width="3" HorizontalAlignment="Left"
                                            Background="{StaticResource AccentBrush}" IsHitTestVisible="False"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>

                                    <!-- ────────── lane ────────── -->
                                    <Border Grid.Column="1" x:Name="Lane"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                            ClipToBounds="True"
                                            MouseLeftButtonDown="OnLaneMouseDown" MouseMove="OnLaneMouseMove"
                                            MouseLeftButtonUp="OnLaneMouseUp"
                                            PreviewMouseRightButtonDown="OnLaneRightButtonDown"
                                            LostMouseCapture="OnLaneLostCapture"
                                            ContextMenuOpening="OnLaneContextMenuOpening">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#13161B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Fade in" >
                                                    <MenuItem Header="none"  Click="OnFadeIn"  Tag="0"/>
                                                    <MenuItem Header="0.25 s" Click="OnFadeIn" Tag="0.25"/>
                                                    <MenuItem Header="0.5 s"  Click="OnFadeIn" Tag="0.5"/>
                                                    <MenuItem Header="1 s"    Click="OnFadeIn" Tag="1"/>
                                                    <MenuItem Header="2 s"    Click="OnFadeIn" Tag="2"/>
                                                    <MenuItem Header="4 s"    Click="OnFadeIn" Tag="4"/>
                                                </MenuItem>
                                                <MenuItem Header="Fade out">
                                                    <MenuItem Header="none"  Click="OnFadeOut" Tag="0"/>
                                                    <MenuItem Header="0.25 s" Click="OnFadeOut" Tag="0.25"/>
                                                    <MenuItem Header="0.5 s"  Click="OnFadeOut" Tag="0.5"/>
                                                    <MenuItem Header="1 s"    Click="OnFadeOut" Tag="1"/>
                                                    <MenuItem Header="2 s"    Click="OnFadeOut" Tag="2"/>
                                                    <MenuItem Header="4 s"    Click="OnFadeOut" Tag="4"/>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Trim start to playhead" Click="OnTrimStartToPlayhead"/>
                                                <MenuItem Header="Trim end to playhead"   Click="OnTrimEndToPlayhead"/>
                                                <MenuItem Header="Clear trim"             Click="OnClearTrim"/>
                                                <Separator/>
                                                <MenuItem Header="Split at playhead"      Click="OnSplitHere"      InputGestureText="Ctrl+I"/>
                                                <MenuItem Header="Join sections"          Click="OnJoinSections"   InputGestureText="Ctrl+J"/>
                                                <MenuItem Header="Repeat this section"    Click="OnDuplicateSection" InputGestureText="Ctrl+D" Tag="repeat"/>
                                                <Separator/>
                                                <!-- Tagged: with a stretch marked they act on it, and say so (PrepareLaneMenu). -->
                                                <MenuItem Header="Cut section"            Click="OnCutSection"     InputGestureText="Ctrl+X" Tag="cut"/>
                                                <MenuItem Header="Copy section"           Click="OnCopySection"    InputGestureText="Ctrl+C" Tag="copy"/>
                                                <MenuItem Header="Paste at playhead"      Click="OnPasteSection"   InputGestureText="Ctrl+V"/>
                                                <MenuItem Header="Delete section"         Click="OnDeleteSection"  Tag="delete"/>
                                                <Separator/>
                                                <MenuItem Header="Move section to playhead" Click="OnMoveToPlayhead"/>
                                                <MenuItem Header="Loop mode — drag an end to repeat" Tag="loopmode" IsCheckable="True"
                                                          Click="OnLoopModeMenu" InputGestureText="Ctrl+L"/>
                                                <MenuItem Header="Add empty track" Click="OnAddEmptyTrackMenu" InputGestureText="Ctrl+T"/>
                                                <Separator Tag="removeRamp"/>
                                                <MenuItem Header="Remove tempo ramp" Tag="removeRamp" Click="OnRemoveRampMenu"/>
                                                <!-- Shown only over a warp marker, in any mode (PrepareLaneMenu). Over a
                                                     ramp too, the two items share the ramp's separator. -->
                                                <Separator Tag="removeWarp"/>
                                                <MenuItem Header="Remove warp marker" Tag="removeWarp" Click="OnRemoveWarpMenu"/>
                                                <Separator/>
                                                <!-- A Click handler like every item above, never a Command bound
                                                     through RelativeSource AncestorType=Window: a ContextMenu is
                                                     not inside the window, so that binding comes back empty and
                                                     the item silently does nothing. Until 2026-10-03 this one did. -->
                                                <MenuItem Header="Split into vocals + instrumental" Click="OnSplitStems"
                                                          ToolTip="Runs on your GPU, about 20 seconds. Downloads a 64 MB model the first time."/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <c:WaveformView
                                                Clips="{Binding ClipVisuals}"
                                                PixelsPerSecond="{Binding DataContext.PixelsPerSecond, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ScrollSeconds="{Binding DataContext.ScrollSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                LoopMode="{Binding DataContext.LoopMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Ramps="{Binding RampVisuals}"
                                                Warps="{Binding WarpVisuals}"
                                                WarpBrush="{StaticResource WarpBrush}"
                                                Mark="{Binding MarkVisual}"
                                                IsMuted="{Binding Muted}"
                                                WaveBrush="{Binding ColorBrush}"
                                                ClipBackground="{Binding ClipBackground}"/>
                                            <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource BadBrush}"
                                                       FontSize="11.5" Margin="10" VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Empty track — click here, then Ctrl+V pastes at the playhead. Or drag a section onto it, or drop a song file on it."
                                                       Style="{StaticResource Caption}" Margin="14,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" TextWrapping="Wrap"
                                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
                                            <!-- The end tempo of a tempo ramp, typed beside its end dot. An element in the
                                                 lane, not a Popup: no window of its own, so in a scripted run it is off-screen
                                                 with the rest, and it is never given the keyboard there. -->
                                            <TextBox x:Name="RampBpmBox" Style="{StaticResource DarkBox}" Width="58" Height="20" FontSize="11.5"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Text="{Binding RampBpmDraft, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsTypingRampBpm, Converter={StaticResource BoolVis}}"
                                                     PreviewKeyDown="OnRampBpmKeyDown" LostKeyboardFocus="OnRampBpmLostFocus"
                                                     IsVisibleChanged="OnRampBpmBoxShown"
                                                     ToolTip="The tempo this ramp should reach, in BPM. Enter keeps it; Esc cancels.">
                                                <TextBox.Margin>
                                                    <MultiBinding Converter="{StaticResource RampBoxPlace}">
                                                        <Binding Path="RampBoxSeconds"/>
                                                        <Binding Path="DataContext.ScrollSeconds" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </TextBox.Margin>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="BelowTracks" Grid.Row="1" Grid.Column="1" Background="Transparent"
                            MouseLeftButtonDown="OnBelowTracksMouseDown" MouseMove="OnBelowTracksMouseMove"
                            MouseLeftButtonUp="OnBelowTracksMouseUp" LostMouseCapture="OnBelowTracksLostCapture"/>
                    <!-- The selection box, over the lanes only, in the rows' own coordinates so it scrolls with them. -->
                    <Canvas x:Name="BandLayer" Grid.RowSpan="2" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="BandRect" Visibility="Collapsed" Fill="#2878C8FF" Stroke="#C878C8FF" StrokeThickness="1"/>
                    </Canvas>
                    <!-- Where a track being dragged up or down will land. -->
                    <Canvas x:Name="ReorderLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False">
                        <Rectangle x:Name="InsertLine" Height="2" Visibility="Collapsed" Fill="{StaticResource AccentBrush}"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- playhead + loop, over both ruler and lanes -->
            <c:PlayheadOverlay Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                               PositionSeconds="{Binding PositionSeconds}"
                               PixelsPerSecond="{Binding PixelsPerSecond}"
                               ScrollSeconds="{Binding ScrollSeconds}"
                               LoopStart="{Binding LoopStart}" LoopEnd="{Binding LoopEnd}"
                               SnapLineSeconds="{Binding SnapLineSeconds}"
                               LineBrush="{StaticResource PlayheadBrush}"/>

            <!-- empty state -->
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Tracks.Count, Converter={StaticResource ZeroVis}}">
                <TextBlock Text="Drop songs here" FontSize="17" Foreground="{StaticResource Text2Brush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="or use + Add tracks. Two songs, Match BPM, and you have a mashup. + Empty track makes a blank one."
                           Style="{StaticResource Caption}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ============ horizontal scroll ============ -->
        <ScrollBar Grid.Row="4" Orientation="Horizontal" Height="14" Margin="392,0,0,0"
                   Minimum="0" Maximum="{Binding MaxScrollSeconds}"
                   SmallChange="1" LargeChange="{Binding ViewportSeconds}"
                   Value="{Binding ScrollSeconds, Mode=TwoWay}"
                   ViewportSize="{Binding ViewportSeconds}"/>

        <!-- ============ status ============ -->
        <Border Grid.Row="5" Background="{StaticResource Bg1Brush}" Padding="12,5"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="150" Height="4" Margin="12,0,0,0"
                             Minimum="0" Maximum="1" Value="{Binding BusyProgress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Typing a knob's exact value (2026-10-12): one box, moved over whichever knob's number was
             double-clicked. In the window itself, not a Popup, so a scripted run never puts a window
             of its own on his screen. The layer has no background, so it takes no clicks itself. -->
        <Canvas x:Name="KnobEditLayer" Grid.RowSpan="5">
            <TextBox x:Name="KnobValueBox" Style="{StaticResource DarkBox}" Width="56" Height="19" FontSize="11"
                     Padding="2,0" TextAlignment="Center" Visibility="Collapsed"
                     PreviewKeyDown="OnKnobValueKeyDown" LostKeyboardFocus="OnKnobValueLostFocus"
                     ToolTip="Type the exact value, then press Enter. Esc keeps it as it was."/>
        </Canvas>
    </Grid>
</Window>
