<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Studio-dark palette. Deliberately low contrast in the chrome so the waveforms and the
         meters are the brightest things on screen - the eye should go to the audio. -->
    <Color x:Key="Bg0">#0F1114</Color>
    <Color x:Key="Bg1">#15181D</Color>
    <Color x:Key="Bg2">#1C2026</Color>
    <Color x:Key="Bg3">#252A32</Color>
    <Color x:Key="Line">#2E343D</Color>
    <Color x:Key="Text0">#E8EBF0</Color>
    <Color x:Key="Text1">#9AA4B2</Color>
    <Color x:Key="Text2">#6B7480</Color>
    <Color x:Key="Accent">#4C8DFF</Color>
    <Color x:Key="AccentDim">#2C4A7A</Color>
    <Color x:Key="Good">#3DD68C</Color>
    <Color x:Key="Warn">#F5C518</Color>
    <Color x:Key="Bad">#E5484D</Color>
    <Color x:Key="Playhead">#FF6B3D</Color>
    <!-- Warp markers (2026-10-18). Tempo ramps are yellow (RampLayout.Yellow); this is kept clear of
         that, of the white of a selection or a mark, and of the paler sky-blue of loop handles and
         the snap guide, which is drawn right over a marker while it is dragged onto something. -->
    <Color x:Key="Warp">#1DE9B6</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
    <SolidColorBrush x:Key="Text0Brush" Color="{StaticResource Text0}"/>
    <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource Good}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource Bad}"/>
    <SolidColorBrush x:Key="PlayheadBrush" Color="{StaticResource Playhead}"/>
    <SolidColorBrush x:Key="WarpBrush" Color="{StaticResource Warp}"/>

    <Style TargetType="Button" x:Key="ToolButton">
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource Text0Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="Button" x:Key="TransportButton" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="ToggleButton" x:Key="PillToggle">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
        <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="3"
                            Padding="7,3" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock" x:Key="Caption">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
        <Setter Property="FontSize" Value="10.5"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="Body">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <Style TargetType="TextBox" x:Key="DarkBox">
        <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource Text0Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text0Brush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Bg3Brush}"/>
    </Style>

</ResourceDictionary>
